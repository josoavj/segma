## Variables lues par le backend local (copier dans .env à la racine si besoin).
HOST=127.0.0.1
PORT=8000
DEVICE=cuda
SAM3_MODEL_ID=facebook/sam3
YOLO_MODEL=yolov8n.pt
MAX_FILE_SIZE=104857600
# UPLOAD_DIR=data/uploads
# OUTPUT_DIR=data/masks
# DEBUG=false
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hugging Face peut lire HF_TOKEN si le modèle exige une authentification.
# Il est également possible d'utiliser `huggingface-cli login`.
# HF_TOKEN=
